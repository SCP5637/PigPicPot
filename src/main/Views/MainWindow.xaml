<Window x:Class="PigPicPot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PigPicPot.Views"
        xmlns:strings="clr-namespace:PigPicPot.Strings"
        mc:Ignorable="d"
        Title="PigPicPot" Height="768" Width="1366" 
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="White"
        Closing="MainWindow_Closing"
        Closed="MainWindow_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Storyboard x:Key="NotificationStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" BeginTime="0:0:2"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
        </Grid.Background>
        <!-- Main Content -->
        <DockPanel x:Name="MainContentPanel" Margin="20" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <ToggleButton x:Name="FavoritesToggleButton" Content="★" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center" Click="FavoritesToggleButton_Click"/>
                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5" Width="300" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
            <TextBlock x:Name="LoadSummaryTextBlock" DockPanel.Dock="Top" Margin="0,10,0,5" FontSize="12" HorizontalAlignment="Center" Text="{Binding LoadSummaryText}"/>
            <TextBlock x:Name="SummaryTextBlock" DockPanel.Dock="Top" Margin="0,0,0,5" FontSize="12" HorizontalAlignment="Center" Text="{Binding SummaryText}"/>

            <!-- Category Filters -->
            <StackPanel x:Name="TagsPanel" DockPanel.Dock="Top" Margin="0,0,0,5">
                <ItemsControl x:Name="Level1TagsItemsControl" ItemsSource="{Binding Level1Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="5,0,5,0" Click="Tag_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="Level2TagsItemsControl" ItemsSource="{Binding Level2Tags}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="5,0,5,0" Click="Tag_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="Level3TagsItemsControl" ItemsSource="{Binding Level3Tags}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="5,0,5,0" Click="Tag_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Favorites Tags -->
            <DockPanel x:Name="FavoritesTagsPanel" DockPanel.Dock="Top" Margin="0,0,0,5" Visibility="Collapsed">
                <Button Content="+ New" DockPanel.Dock="Right" Margin="5,0,0,0" Click="CreateNewFavorite_Click" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding FavoriteTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,0,5,0" Click="FavoriteTag_Click" MouseRightButtonDown="FavoriteTag_RightClick">
                                <ToggleButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="重命名" Click="RenameFavorite_Click"/>
                                        <MenuItem Header="删除" Click="DeleteFavorite_Click"/>
                                    </ContextMenu>
                                </ToggleButton.ContextMenu>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>

            <ListBox x:Name="ImageListBox" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                     Background="#80FFFFFF" 
                     ItemsSource="{Binding FilteredItems}"
                     ScrollViewer.ScrollChanged="ImageListBox_ScrollChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#A0A0A0" BorderThickness="1" Margin="5" Padding="5" CornerRadius="3" Background="White">
                            <Grid Width="150">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.CopyImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>
                                </Grid.InputBindings>
                                <Button Content="★" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" FontSize="16" Background="Transparent" BorderBrush="Transparent" Click="AddImageToFavorite_Click" CommandParameter="{Binding}"/>
                                <StackPanel>
                                    <Grid x:Name="PreviewAndPlayerGrid" Width="150" Height="120" Loaded="ImageItem_Loaded" Unloaded="ImageItem_Unloaded" MouseEnter="Gif_MouseEnter" MouseLeave="Gif_MouseLeave">
                                        <Image x:Name="ThumbnailImage" Source="{Binding ThumbnailSource}" Stretch="Uniform" Cursor="Hand" />
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" Height="40"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingProgressText" Text="{x:Static strings:Resources.LoadingText}" Foreground="White" FontSize="20" Margin="0,0,0,10"/>
                <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="False" Width="300" Height="20" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <!-- Notification Overlay -->
        <Border x:Name="NotificationOverlay" Background="#333" CornerRadius="10" Padding="15,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="NotificationText" Text="Copied to clipboard!" Foreground="White" FontSize="14"/>
        </Border>

        <!-- Info Button -->
        <Button x:Name="InfoButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Width="15" Height="15" Opacity="0.7" Visibility="Collapsed" Click="InfoButton_Click">
            <TextBlock Text="ⓘ" FontSize="11" FontWeight="Bold" Foreground="#4682B4"/>
        </Button>

        <!-- Control Buttons Panel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <!-- Reset Button -->
            <Button x:Name="ResetMemoryButton" Width="15" Height="15" Opacity="0.7" Margin="0,0,5,0" Click="ResetMemoryButton_Click">
                <TextBlock Text="♻" FontSize="11" FontWeight="Bold" Foreground="#4682B4"/>
            </Button>
            
            <!-- Toggle UI Button -->
            <Button x:Name="ToggleUIVisibilityButton" Width="15" Height="15" Opacity="0.7" Click="ToggleUIVisibilityButton_Click">
                <TextBlock Text="Ⓑ" FontSize="11" FontWeight="Bold" Foreground="#4682B4"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>