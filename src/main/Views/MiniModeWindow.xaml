<Window x:Class="PigPicPot.Views.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PigPicPot.Views"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:strings="clr-namespace:PigPicPot.Strings"
        mc:Ignorable="d"
        Title="PigPicPot - Mini Mode"
        Width="640" Height="480"
        Topmost="True"
        WindowStyle="ToolWindow">
    <Window.Background>
        <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
    </Window.Background>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PinButtonStyle" TargetType="ToggleButton">
            <Setter Property="Content" Value="📌"/>
            <Setter Property="ToolTip" Value="钉住窗口 (复制后不关闭)"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="📍"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <Storyboard x:Key="NotificationStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" BeginTime="0:0:2"/>
            </Storyboard>
        </Grid.Resources>
        <DockPanel x:Name="MainContentPanel" Margin="10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <ToggleButton x:Name="FavoritesToggleButton" Content="★" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center" Click="FavoritesToggleButton_Click"/>
                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5" Width="300"/>
                <ToggleButton Style="{StaticResource PinButtonStyle}" IsChecked="{Binding IsPinned, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock x:Name="SummaryTextBlock" DockPanel.Dock="Top" Margin="0,0,0,5" FontSize="10" HorizontalAlignment="Center"/>

            <!-- Category Filters -->
            <StackPanel x:Name="TagsPanel" DockPanel.Dock="Top" Margin="0,0,0,5">
                <ItemsControl ItemsSource="{Binding Level1Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="3,0,3,0" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Level2Tags}" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="3,0,3,0" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Level3Tags}" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="3,0,3,0" FontSize="10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Favorites Tags -->
            <WrapPanel x:Name="FavoritesTagsPanel" DockPanel.Dock="Top" Margin="0,0,0,5" Visibility="Collapsed">
                <ItemsControl x:Name="FavoritesTagsItemsControl" ItemsSource="{Binding FavoriteTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,0,5,0" Click="FavoriteTag_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </WrapPanel>

            <ListBox x:Name="ImageListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#80FFFFFF" ItemsSource="{Binding FilteredItems}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DataTemplate.Resources>
                            <Storyboard x:Key="CarouselAnimation" RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PreviewStart" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.7" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PreviewMiddle" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.7" Value="{x:Static Visibility.Visible}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:1.4" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PreviewEnd" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:1.4" Value="{x:Static Visibility.Visible}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:2.1" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </DataTemplate.Resources>
                        <Border BorderBrush="#A0A0A0" BorderThickness="1" Margin="3" Padding="3" CornerRadius="2" Background="White">
                            <Grid Width="100">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.CopyImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>
                                </Grid.InputBindings>
                                <StackPanel>
                                    <Grid x:Name="PreviewAndPlayerGrid" Width="100" Height="80" Loaded="ImageItem_Loaded" Unloaded="ImageItem_Unloaded" MouseEnter="Gif_MouseEnter" MouseLeave="Gif_MouseLeave">
                                        <Image x:Name="ThumbnailImage" Source="{Binding ThumbnailSource}" Stretch="Uniform" Cursor="Hand" />
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" Height="30" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Notification Overlay -->
        <Border x:Name="NotificationOverlay" Background="#333" CornerRadius="5" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="NotificationText" Text="Copied to clipboard!" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Control Buttons Panel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <!-- Reset Button -->
            <Button x:Name="ResetMemoryButton" Width="15" Height="15" Opacity="0.7" Margin="0,0,5,0" Click="ResetMemoryButton_Click">
                <TextBlock Text="♻" FontSize="11" FontWeight="Bold" Foreground="#4682B4"/>
            </Button>
            
            <!-- Toggle Background Button -->
            <Button x:Name="ToggleBackgroundButton" Width="15" Height="15" Opacity="0.7" Click="ToggleBackgroundButton_Click">
                <TextBlock Text="Ⓑ" FontSize="11" FontWeight="Bold" Foreground="#4682B4"/>
            </Button>
        </StackPanel>

        <!-- Info Button -->
        <Button x:Name="MiniInfoButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Width="15" Height="15" Opacity="0.7" Visibility="Collapsed">
            <TextBlock Text="ⓘ" FontSize="11" FontWeight="Bold" Foreground="#4682B4"/>
        </Button>
    </Grid>
</Window>
