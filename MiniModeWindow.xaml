<Window x:Class="PigPicPot.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PigPicPot"
        xmlns:strings="clr-namespace:PigPicPot.Strings"
        mc:Ignorable="d"
        Title="PigPicPot - Mini Mode"
        Width="640" Height="480"
        Topmost="True"
        WindowStyle="ToolWindow">
    <Window.Background>
        <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
    </Window.Background>
    <Grid>
        <Grid.Resources>
            <Storyboard x:Key="NotificationStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" BeginTime="0:0:2"/>
            </Storyboard>
        </Grid.Resources>
        <DockPanel x:Name="MainContentPanel" Margin="10">
            <TextBox x:Name="SearchTextBox" DockPanel.Dock="Top" Margin="0,0,0,5" FontSize="12" Padding="3"/>
            <TextBlock x:Name="SummaryTextBlock" DockPanel.Dock="Top" Margin="0,0,0,5" FontSize="10" HorizontalAlignment="Center"/>

            <!-- Category Filters -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="StaticFilterButton" Content="{x:Static strings:Resources.StaticFilterButtonText}" Margin="0,0,5,0"/>
                    <ToggleButton x:Name="DynamicFilterButton" Content="{x:Static strings:Resources.DynamicFilterButtonText}" Margin="5,0,5,0"/>
                </StackPanel>
                <StackPanel x:Name="StaticSubFilterPanel" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                    <ToggleButton x:Name="ZhuxxFilterButton" Content="{x:Static strings:Resources.ZhuxxFilterButtonText}" Margin="0,0,5,0"/>
                    <ToggleButton x:Name="OtherFilterButton" Content="{x:Static strings:Resources.OtherFilterButtonText}" Margin="5,0,5,0"/>
                </StackPanel>
                <StackPanel x:Name="DynamicSubFilterPanel" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                    <ToggleButton x:Name="AnimeFilterButton" Content="{x:Static strings:Resources.AnimeFilterButtonText}" Margin="0,0,5,0"/>
                    <ToggleButton x:Name="RealFilterButton" Content="{x:Static strings:Resources.RealFilterButtonText}" Margin="5,0,5,0"/>
                </StackPanel>

                <!-- Level 3 Filters with ScrollViewer -->
                <ScrollViewer x:Name="Level3ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,5,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="Level3FilterPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>

            <ListBox x:Name="ImageListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#80FFFFFF">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DataTemplate.Resources>
                            <Storyboard x:Key="CarouselAnimation" RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PreviewStart" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.7" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PreviewMiddle" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.7" Value="{x:Static Visibility.Visible}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:1.4" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PreviewEnd" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:1.4" Value="{x:Static Visibility.Visible}"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:2.1" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </DataTemplate.Resources>
                        <Border BorderBrush="#A0A0A0" BorderThickness="1" Margin="3" Padding="3" CornerRadius="2" Background="White">
                            <Grid Width="100">
                                <StackPanel>
                                    <Grid x:Name="PreviewAndPlayerGrid" Width="100" Height="80" MouseEnter="Gif_MouseEnter" MouseLeave="Gif_MouseLeave" MouseLeftButtonDown="Image_MouseLeftButtonDown">
                                        <!-- 3-Frame Preview Carousel -->
                                        <Grid x:Name="CarouselGrid">
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="Grid.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource CarouselAnimation}"/>
                                                </EventTrigger>
                                            </Grid.Triggers>
                                            <Image x:Name="PreviewStart" Source="{Binding StartFrame}" Stretch="Uniform" Cursor="Hand" Visibility="Collapsed"/>
                                            <Image x:Name="PreviewMiddle" Source="{Binding MiddleFrame}" Stretch="Uniform" Cursor="Hand" Visibility="Collapsed"/>
                                            <Image x:Name="PreviewEnd" Source="{Binding EndFrame}" Stretch="Uniform" Cursor="Hand" Visibility="Collapsed"/>
                                        </Grid>
                                        <!-- Full GIF Player -->
                                        <MediaElement x:Name="GifPlayer" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="GifPlayer_MediaEnded"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayFileName}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" Height="30" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Notification Overlay -->
        <Border x:Name="NotificationOverlay" Background="#333" CornerRadius="5" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="NotificationText" Text="Copied to clipboard!" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
