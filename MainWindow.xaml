<Window x:Class="PigPicPot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PigPicPot"
        Width="420"
        Height="420"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Deactivated="Window_Deactivated">
    <Grid Margin="10">
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                        <Grid Width="120" Height="120" MouseEnter="Gif_MouseEnter" MouseLeave="Gif_MouseLeave" MouseLeftButtonDown="Image_MouseLeftButtonDown">
                            <Image x:Name="ThumbnailImage" Source="{Binding Thumbnail}" Stretch="Uniform"/>
                            <MediaElement x:Name="GifPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" Stretch="Uniform" MediaEnded="GifPlayer_MediaEnded"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
