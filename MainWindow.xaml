<Window x:Class="PigPicPot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PigPicPot"
        xmlns:strings="clr-namespace:PigPicPot.Strings"
        mc:Ignorable="d"
        Title="PigPicPot">
    <Window.Resources>
        <Storyboard x:Key="NotificationStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" BeginTime="0:0:2"/>
        </Storyboard>
    </Window.Resources>
    <Window.Background>
        <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
    </Window.Background>
    <Grid>
        <!-- Main Content -->
        <DockPanel Margin="20">
            <TextBox x:Name="SearchTextBox" DockPanel.Dock="Top" Margin="0,0,0,10" TextChanged="SearchTextBox_TextChanged" FontSize="14" Padding="5"/>
            <ListBox x:Name="ImageListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="ImageListBox_Loaded" Background="#80FFFFFF">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#A0A0A0" BorderThickness="1" Margin="5" Padding="5" CornerRadius="3" Background="White">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static strings:Resources.CopyStatic}" Click="CopyStatic_Click"/>
                                    <MenuItem Header="{x:Static strings:Resources.CopyFile}" Click="CopyFile_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Width="150">
                                <Grid Width="150" Height="120">
                                    <Image Source="{Binding FilePath}" Stretch="Uniform" Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
                                    <MediaElement x:Name="GifPlayer" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaEnded="GifPlayer_MediaEnded" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
                                </Grid>
                                <TextBlock Text="{Binding DisplayFileName}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" Height="40"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- GIF Copy Options Popup -->
        <Popup x:Name="GifCopyPopup" Placement="MousePoint" AllowsTransparency="True" StaysOpen="False">
            <Border Background="#F0F0F0" BorderBrush="#888" BorderThickness="1" CornerRadius="5" Padding="5">
                <StackPanel>
                    <Button Content="{x:Static strings:Resources.CopyStatic}" Margin="2" Click="CopyStatic_Click"/>
                    <Button Content="{x:Static strings:Resources.CopyFile}" Margin="2" Click="CopyFile_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Notification Overlay -->
        <Border x:Name="NotificationOverlay" Background="#333" CornerRadius="10" Padding="15,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="NotificationText" Text="Copied to clipboard!" Foreground="White" FontSize="14"/>
        </Border>
    </Grid>
</Window>
